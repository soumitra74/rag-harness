# Postgres (used for local/non-docker dev; docker-compose overrides DATABASE_URL
# to use the `postgres` service hostname for the backend container)
DATABASE_URL=postgresql://raguser:ragpass@localhost:15443/ragdb

# Host port for the rag Postgres container (default 15432)
POSTGRES_HOST_PORT=15443
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# Providers — chat and embeddings are selected independently since
# Anthropic has no embeddings API.
CHAT_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1536

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Only used when CHAT_PROVIDER or EMBEDDING_PROVIDER is "ollama". Points at
# the host's own Ollama installation (docker-compose overrides this to
# http://host.docker.internal:11434 for the backend container — do not use
# the dockerized `ollama` profile service's hostname here, it has no models
# pulled).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Only used when EMBEDDING_PROVIDER=local — runs in-process via
# sentence-transformers (no Ollama/API call). See
# app/providers/local_embedding_provider.py for the full model registry.
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=25

# Evaluation harness (eval/) — judge provider is independent of the
# backend's own CHAT_PROVIDER.
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini

# LLM for sweep code generation. Leave unset to use the eval judge.
CODEGEN_PROVIDER=
CODEGEN_MODEL=

# Frontend
VITE_API_BASE_URL=http://localhost:8098
